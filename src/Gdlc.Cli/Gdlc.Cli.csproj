<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Gdlc.Cli</RootNamespace>
    <AssemblyName>gdlc</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>gdlc</ToolCommandName>
    <Version>1.0.0</Version>
    <Description>Unified GDL front-end with plugin registry emit/validate/sat (GUIDERS-ADR-0059 §10, ATC-ADR-0002).</Description>
    <GuidersPlatformRoot Condition="'$(GuidersPlatformRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\guiders-platform</GuidersPlatformRoot>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Gdlc.Cli.SmokeTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Gdlc.Plugins.Federation\Gdlc.Plugins.Federation.csproj" />
    <ProjectReference Include="$(GuidersPlatformRoot)\src\AIGuiders.Platform.Authoring.Core\AIGuiders.Platform.Authoring.Core.csproj" />
  </ItemGroup>
</Project>
