<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Gdlc.Cli</RootNamespace>
    <AssemblyName>gdlc</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>gdlc</ToolCommandName>
    <Description>Wave-1 stub unified GDL front-end (GUIDERS-ADR-0059 §10).</Description>
    <GuidersPlatformRoot Condition="'$(GuidersPlatformRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\guiders-platform</GuidersPlatformRoot>
    <GuidersWpfRoot Condition="'$(GuidersWpfRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\guiders-wpf</GuidersWpfRoot>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Gdlc.Cli.SmokeTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(GuidersPlatformRoot)\src\AIGuiders.Platform.Authoring.Command.Catalog\AIGuiders.Platform.Authoring.Command.Catalog.csproj" />
    <ProjectReference Include="$(GuidersPlatformRoot)\src\AIGuiders.Platform.Authoring.Command.Bundles\AIGuiders.Platform.Authoring.Command.Bundles.csproj" />
    <ProjectReference Include="$(GuidersPlatformRoot)\src\AIGuiders.Platform.Authoring.Deck\AIGuiders.Platform.Authoring.Deck.csproj" />
    <ProjectReference Include="$(GuidersPlatformRoot)\src\AIGuiders.Platform.Execution.CommandPlane.Catalog.CodeGen\AIGuiders.Platform.Execution.CommandPlane.Catalog.CodeGen.csproj" />
    <ProjectReference Include="$(GuidersWpfRoot)\src\AIGuiders.Surface.Wpf.CodeGen\AIGuiders.Surface.Wpf.CodeGen.csproj" />
  </ItemGroup>
</Project>
